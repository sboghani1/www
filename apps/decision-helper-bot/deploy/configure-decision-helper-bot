#!/bin/bash
# Write Mel's env file (prompts for the @decision_helpers_bot token on first run).
set -euo pipefail
umask 077

if [[ "$EUID" -ne 0 ]]; then
    echo "Run as root." >&2
    exit 1
fi

gateway_env="/home/receptionist2/.config/receptionist2/gateway.env"
# BetOnline lines come from telegram-channel-forwarder's intake workbook; Mel
# reads them with the forwarder's Google service account and never calls
# The Odds API.
forwarder_env="/home/forwarder/app/.env"
config_dir="/home/receptionist-agent/.config/decision-helper-bot"
env_file="$config_dir/env"

read_value() {
    sed -n "s/^$1=//p" "$2" 2>/dev/null | tail -1 | sed "s/^'\\(.*\\)'\$/\\1/; s/^\"\\(.*\\)\"\$/\\1/"
}

allowed_user_id="$(read_value TELEGRAM_ALLOWED_USER_ID "$gateway_env")"
if [[ ! "$allowed_user_id" =~ ^[1-9][0-9]*$ ]]; then
    echo "Could not load TELEGRAM_ALLOWED_USER_ID from $gateway_env." >&2
    exit 1
fi

# Re-running keeps the existing token; only a first install prompts.
token="$(read_value DECISION_HELPER_BOT_TOKEN "$env_file")"
if [[ -z "$token" ]]; then
    read -r -s -p "BotFather token for @decision_helpers_bot: " token
    echo
fi
if [[ -z "$token" ]]; then
    echo "Token cannot be empty." >&2
    exit 1
fi

google_credentials="$(read_value GOOGLE_CREDENTIALS "$forwarder_env")"
lines_sheet_id="$(read_value NBA_INTAKE_SHEET_ID "$forwarder_env")"
if [[ -z "$lines_sheet_id" ]]; then
    lines_sheet_id="$(read_value NFL_INTAKE_SHEET_ID "$forwarder_env")"
fi
if [[ -z "$google_credentials" || -z "$lines_sheet_id" ]]; then
    echo "Could not load GOOGLE_CREDENTIALS and the intake sheet ID from $forwarder_env." >&2
    exit 1
fi

install -d -m 0700 -o receptionist-agent -g receptionist-agent "$config_dir"
temporary="$(mktemp)"
trap 'rm -f "$temporary"' EXIT
cat >"$temporary" <<EOF
DECISION_HELPER_BOT_TOKEN=$token
DECISION_HELPER_EXPECTED_USERNAME=decision_helpers_bot
TELEGRAM_ALLOWED_USER_ID=$allowed_user_id
GOOGLE_CREDENTIALS=$google_credentials
DECISION_HELPER_LINES_SHEET_ID=$lines_sheet_id
DECISION_HELPER_STATE_DIR=/var/lib/decision-helper-bot
DECISION_HELPER_CLAUDE_MODEL=claude-opus-5-5
DECISION_HELPER_CLAUDE_EFFORT=medium
DECISION_HELPER_WHISPER_MODEL=small.en
EOF
install -m 0600 -o receptionist-agent -g receptionist-agent \
    "$temporary" "$env_file"
systemctl enable decision-helper-bot.service
systemctl restart decision-helper-bot.service
sleep 5
systemctl is-active --quiet decision-helper-bot.service
echo "@decision_helpers_bot (Mel) configured and active."
