[Unit]
Description=Receptionist2 independent watchdog and restart controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=receptionist2-watchdog
Group=receptionist2-state
WorkingDirectory=/opt/receptionist2/current/apps/receptionist2
Environment=HOME=/home/receptionist2-watchdog
Environment=PATH=/opt/receptionist2/current/.venv/bin:/usr/bin:/bin
EnvironmentFile=/etc/receptionist2/watchdog.env
ExecStart=/opt/receptionist2/current/.venv/bin/receptionist2-watchdog
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/receptionist2
NoNewPrivileges=false
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0007

[Install]
WantedBy=multi-user.target
