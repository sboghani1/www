[Unit]
Description=Receptionist2 Telegram gateway
After=network-online.target receptionist2-worker.service
Wants=network-online.target

[Service]
Type=simple
User=receptionist2
Group=receptionist2-state
WorkingDirectory=/opt/receptionist2/current/apps/receptionist2
Environment=HOME=/home/receptionist2
Environment=PATH=/opt/receptionist2/current/.venv/bin:/usr/bin:/bin
EnvironmentFile=/home/receptionist2/.config/receptionist2/gateway.env
ExecStart=/opt/receptionist2/current/.venv/bin/receptionist2-gateway
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/receptionist2
ReadOnlyPaths=/home/receptionist2/.config/receptionist2
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0007

[Install]
WantedBy=multi-user.target
