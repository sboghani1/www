[Unit]
Description=Receptionist2 durable agent worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=receptionist2-worker
Group=receptionist2-state
WorkingDirectory=/opt/receptionist2/current/apps/receptionist2
Environment=HOME=/home/receptionist2-worker
Environment=PATH=/opt/receptionist2/current/.venv/bin:/usr/bin:/bin
EnvironmentFile=/etc/receptionist2/worker.env
ExecStart=/opt/receptionist2/current/.venv/bin/receptionist2-worker
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
# Agent runs inherit this unit's namespace. Like the forwarder's
# claude-channels.service, the worker is deliberately unsandboxed so agents
# see and can change the real host with their root sudo.
NoNewPrivileges=false
UMask=0007

[Install]
WantedBy=multi-user.target
