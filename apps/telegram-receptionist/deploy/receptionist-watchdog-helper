#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

SERVICE = "telegram-receptionist.service"
CURRENT_RELEASE = Path("/opt/telegram-receptionist/current")
CLAUDE_BINARY = "/usr/bin/claude"
CLAUDE_USER = "receptionist-agent"
DEPLOYMENT_DRAIN = Path(
    "/var/lib/telegram-receptionist/deployment-drain.json"
)


def run(command: list[str], *, check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        command,
        check=check,
        capture_output=True,
        text=True,
        timeout=45,
    )


def service_status() -> None:
    result = run(
        [
            "/usr/bin/systemctl",
            "show",
            SERVICE,
            "--property=ActiveState,SubState,MainPID,NRestarts",
        ],
        check=True,
    )
    values = {}
    for line in result.stdout.splitlines():
        key, _, value = line.partition("=")
        values[key] = value
    revision = "unknown"
    try:
        revision = Path(os.path.realpath(CURRENT_RELEASE)).name
    except OSError:
        pass
    claude_logged_in = None
    claude_auth_method = "unknown"
    auth = run(
        [
            "/usr/bin/sudo",
            "-n",
            "-H",
            "-u",
            CLAUDE_USER,
            CLAUDE_BINARY,
            "auth",
            "status",
        ]
    )
    if auth.returncode == 0:
        try:
            auth_status = json.loads(auth.stdout)
        except json.JSONDecodeError:
            auth_status = {}
        if isinstance(auth_status, dict):
            logged_in = auth_status.get("loggedIn")
            if isinstance(logged_in, bool):
                claude_logged_in = logged_in
            method = auth_status.get("authMethod")
            if isinstance(method, str) and method:
                claude_auth_method = method
    print(
        json.dumps(
            {
                "active_state": values.get("ActiveState", "unknown"),
                "sub_state": values.get("SubState", "unknown"),
                "main_pid": values.get("MainPID", "unknown"),
                "restarts": values.get("NRestarts", "unknown"),
                "revision": revision,
                "deployment_drain": DEPLOYMENT_DRAIN.exists(),
                "claude_logged_in": claude_logged_in,
                "claude_auth_method": claude_auth_method,
            }
        )
    )


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("Usage: receptionist-watchdog-helper ACTION")
    action = sys.argv[1]
    if action == "status":
        service_status()
        return
    if action == "restart":
        run(["/usr/bin/systemctl", "restart", SERVICE], check=True)
        service_status()
        return
    if action == "logs":
        result = run(
            [
                "/usr/bin/journalctl",
                "-u",
                SERVICE,
                "--no-pager",
                "--since=-2 hours",
                "-n",
                "300",
                "--output=json",
            ],
            check=True,
        )
        entries = []
        for line in result.stdout.splitlines():
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            entries.append(
                {
                    "timestamp": record.get("__REALTIME_TIMESTAMP"),
                    "priority": record.get("PRIORITY"),
                    "message": record.get("MESSAGE"),
                }
            )
        print(json.dumps({"entries": entries}))
        return
    if action == "reauth":
        result = subprocess.run(
            [
                "/usr/bin/sudo",
                "-n",
                "-H",
                "-u",
                CLAUDE_USER,
                CLAUDE_BINARY,
                "auth",
                "login",
            ],
            check=False,
        )
        raise SystemExit(result.returncode)
    raise SystemExit("Unsupported watchdog action.")


if __name__ == "__main__":
    main()
