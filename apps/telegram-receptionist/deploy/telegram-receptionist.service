[Unit]
Description=Private Telegram coding-agent receptionist
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=receptionist
Group=receptionist
WorkingDirectory=/opt/telegram-receptionist/current/apps/telegram-receptionist
Environment=HOME=/home/receptionist
Environment=PATH=/opt/telegram-receptionist/current/.venv/bin:/usr/bin:/bin
EnvironmentFile=/home/receptionist/.config/telegram-receptionist/env
ExecStart=/opt/telegram-receptionist/current/.venv/bin/telegram-receptionist
Restart=on-failure
RestartSec=5
WatchdogSec=60
NotifyAccess=main
KillMode=control-group
TimeoutStopSec=20
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/receptionist/repos
ReadWritePaths=/home/receptionist-agent
ReadWritePaths=/var/lib/telegram-receptionist
ReadOnlyPaths=/home/receptionist/.config/telegram-receptionist
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
