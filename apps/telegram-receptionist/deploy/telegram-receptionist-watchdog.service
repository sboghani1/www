[Unit]
Description=Break-glass Telegram watchdog for the receptionist
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=receptionist-watchdog
Group=receptionist-watchdog
WorkingDirectory=/opt/telegram-receptionist/current/apps/telegram-receptionist
Environment=HOME=/nonexistent
Environment=PATH=/opt/telegram-receptionist/current/.venv/bin:/usr/bin:/bin
EnvironmentFile=/etc/telegram-receptionist-watchdog.env
ExecStart=/opt/telegram-receptionist/current/.venv/bin/telegram-receptionist-watchdog
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
