#!/usr/bin/python3
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path("/home/receptionist/repos").resolve()
CLAUDE_BINARY = "/usr/bin/claude"
GOOGLE_ENV = Path(
    "/home/receptionist-agent/.config/receptionist-agent/google.env"
)
ALLOWED_GOOGLE_KEYS = {
    "GOOGLE_CREDENTIALS",
    "GOOGLE_SERVICE_ACCOUNT_JSON",
    "NFL_INTAKE_SHEET_ID",
    "WNBA_SHEET_ID",
}
SESSION_ID_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
    r"[0-9a-f]{4}-[0-9a-f]{12}$"
)
CLAUDE_PROJECTS = Path("/home/receptionist-agent/.claude/projects")
GIT_BINARY = "/usr/bin/git"


def load_google_environment() -> None:
    if not GOOGLE_ENV.is_file():
        return
    for line in GOOGLE_ENV.read_text(encoding="utf-8").splitlines():
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key in ALLOWED_GOOGLE_KEYS:
            os.environ[key] = value


def recover_session(session_id: str) -> None:
    if not SESSION_ID_RE.fullmatch(session_id):
        raise SystemExit("Invalid Claude session ID.")
    matches = list(CLAUDE_PROJECTS.glob(f"*/{session_id}.jsonl"))
    if len(matches) != 1 or matches[0].is_symlink():
        raise SystemExit("Claude session log was not found.")

    final_response = ""
    final_response_timestamp = ""
    last_timestamp = ""
    last_conversation_type = ""
    last_conversation_timestamp = ""
    last_assistant_has_tool_use = False
    with matches[0].open(encoding="utf-8") as handle:
        for line in handle:
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            timestamp = row.get("timestamp")
            if isinstance(timestamp, str):
                last_timestamp = timestamp
            row_type = row.get("type")
            if row_type in {"assistant", "user"}:
                last_conversation_type = row_type
                last_conversation_timestamp = (
                    timestamp if isinstance(timestamp, str) else ""
                )
            if row_type != "assistant":
                continue
            message = row.get("message")
            if not isinstance(message, dict):
                continue
            content = message.get("content")
            if not isinstance(content, list):
                continue
            last_assistant_has_tool_use = any(
                isinstance(block, dict) and block.get("type") == "tool_use"
                for block in content
            )
            text = "\n".join(
                str(block.get("text", ""))
                for block in content
                if isinstance(block, dict) and block.get("type") == "text"
            ).strip()
            if text:
                final_response = text
                final_response_timestamp = (
                    timestamp if isinstance(timestamp, str) else ""
                )

    tasks_dir = Path("/home/receptionist-agent/.claude/tasks") / session_id
    task_statuses = []
    if tasks_dir.is_dir():
        for task_path in sorted(tasks_dir.glob("*.json")):
            try:
                task = json.loads(task_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            task_statuses.append(str(task.get("status", "unknown")))

    print(
        json.dumps(
            {
                "final_response": final_response,
                "final_response_timestamp": final_response_timestamp,
                "last_timestamp": last_timestamp,
                "last_conversation_type": last_conversation_type,
                "last_conversation_timestamp": last_conversation_timestamp,
                "last_assistant_has_tool_use": last_assistant_has_tool_use,
                "task_statuses": task_statuses,
            },
            ensure_ascii=False,
        )
    )


def inspect_repository(repository_value: str) -> None:
    repository = Path(repository_value).resolve()
    if not repository.is_relative_to(REPO_ROOT) or not repository.is_dir():
        raise SystemExit("Repository is outside the approved root or missing.")

    def git(*arguments: str) -> str:
        result = subprocess.run(
            [GIT_BINARY, "-C", str(repository), *arguments],
            check=False,
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise SystemExit(
                result.stderr.strip() or "Repository inspection failed."
            )
        return result.stdout.strip()

    print(
        json.dumps(
            {
                "revision": git("rev-parse", "HEAD"),
                "upstream_revision": git("rev-parse", "@{upstream}"),
                "branch": git("branch", "--show-current"),
                "clean": not bool(git("status", "--porcelain")),
            }
        )
    )


def main() -> None:
    try:
        request = json.loads(sys.stdin.read())
        action = request.get("action", "run")
        if action == "recover_session":
            recover_session(str(request["session_id"]))
            return
        if action == "inspect_repository":
            inspect_repository(str(request["repository"]))
            return
        if action != "run":
            raise SystemExit("Unsupported agent action.")
        repository = Path(request["repository"]).resolve()
        command = request["command"]
    except (json.JSONDecodeError, KeyError, TypeError, OSError) as error:
        raise SystemExit(f"Invalid agent request: {error}") from error

    if not repository.is_relative_to(REPO_ROOT) or not repository.is_dir():
        raise SystemExit("Repository is outside the approved root or missing.")
    if (
        not isinstance(command, list)
        or not command
        or command[0] != CLAUDE_BINARY
        or any(not isinstance(argument, str) for argument in command)
    ):
        raise SystemExit("Only the configured Claude command is allowed.")

    os.chdir(repository)
    load_google_environment()
    os.environ["CLAUDE_CODE_DISABLE_BACKGROUND_TASKS"] = "1"
    os.execv(CLAUDE_BINARY, command)


if __name__ == "__main__":
    main()
