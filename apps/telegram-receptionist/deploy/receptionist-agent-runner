#!/usr/bin/python3
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import threading
import uuid
from datetime import UTC, datetime, timedelta
from pathlib import Path

REPO_ROOT = Path("/home/receptionist/repos").resolve()
CLAUDE_BINARY = "/usr/bin/claude"
GOOGLE_ENV = Path(
    "/home/receptionist-agent/.config/receptionist-agent/google.env"
)
ALLOWED_GOOGLE_KEYS = {
    "GOOGLE_CREDENTIALS",
    "GOOGLE_SERVICE_ACCOUNT_JSON",
    "NFL_INTAKE_SHEET_ID",
    "WNBA_SHEET_ID",
}
SESSION_ID_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
    r"[0-9a-f]{4}-[0-9a-f]{12}$"
)
CLAUDE_PROJECTS = Path("/home/receptionist-agent/.claude/projects")
GIT_BINARY = "/usr/bin/git"
RUN_STATE_DIR = Path(
    "/home/receptionist-agent/.local/state/telegram-receptionist/runs"
)


def load_google_environment() -> None:
    if not GOOGLE_ENV.is_file():
        return
    for line in GOOGLE_ENV.read_text(encoding="utf-8").splitlines():
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key in ALLOWED_GOOGLE_KEYS:
            os.environ[key] = value


def recover_session(session_id: str) -> None:
    if not SESSION_ID_RE.fullmatch(session_id):
        raise SystemExit("Invalid Claude session ID.")
    matches = list(CLAUDE_PROJECTS.glob(f"*/{session_id}.jsonl"))
    if len(matches) != 1 or matches[0].is_symlink():
        raise SystemExit("Claude session log was not found.")

    final_response = ""
    final_response_timestamp = ""
    last_timestamp = ""
    last_conversation_type = ""
    last_conversation_timestamp = ""
    last_assistant_has_tool_use = False
    with matches[0].open(encoding="utf-8") as handle:
        for line in handle:
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            timestamp = row.get("timestamp")
            if isinstance(timestamp, str):
                last_timestamp = timestamp
            row_type = row.get("type")
            if row_type in {"assistant", "user"}:
                last_conversation_type = row_type
                last_conversation_timestamp = (
                    timestamp if isinstance(timestamp, str) else ""
                )
            if row_type != "assistant":
                continue
            message = row.get("message")
            if not isinstance(message, dict):
                continue
            content = message.get("content")
            if not isinstance(content, list):
                continue
            last_assistant_has_tool_use = any(
                isinstance(block, dict) and block.get("type") == "tool_use"
                for block in content
            )
            text = "\n".join(
                str(block.get("text", ""))
                for block in content
                if isinstance(block, dict) and block.get("type") == "text"
            ).strip()
            if text:
                final_response = text
                final_response_timestamp = (
                    timestamp if isinstance(timestamp, str) else ""
                )

    tasks_dir = Path("/home/receptionist-agent/.claude/tasks") / session_id
    task_statuses = []
    if tasks_dir.is_dir():
        for task_path in sorted(tasks_dir.glob("*.json")):
            try:
                task = json.loads(task_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            task_statuses.append(str(task.get("status", "unknown")))

    print(
        json.dumps(
            {
                "final_response": final_response,
                "final_response_timestamp": final_response_timestamp,
                "last_timestamp": last_timestamp,
                "last_conversation_type": last_conversation_type,
                "last_conversation_timestamp": last_conversation_timestamp,
                "last_assistant_has_tool_use": last_assistant_has_tool_use,
                "task_statuses": task_statuses,
            },
            ensure_ascii=False,
        )
    )


def inspect_repository(repository_value: str) -> None:
    repository = Path(repository_value).resolve()
    if not repository.is_relative_to(REPO_ROOT) or not repository.is_dir():
        raise SystemExit("Repository is outside the approved root or missing.")

    def git(*arguments: str) -> str:
        result = subprocess.run(
            [GIT_BINARY, "-C", str(repository), *arguments],
            check=False,
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise SystemExit(
                result.stderr.strip() or "Repository inspection failed."
            )
        return result.stdout.strip()

    print(
        json.dumps(
            {
                "revision": git("rev-parse", "HEAD"),
                "upstream_revision": git("rev-parse", "@{upstream}"),
                "branch": git("branch", "--show-current"),
                "clean": not bool(git("status", "--porcelain")),
            }
        )
    )


def recover_run_receipt(run_id_value: str) -> None:
    run_id = str(uuid.UUID(run_id_value))
    receipt_path = RUN_STATE_DIR / f"{run_id}.receipt.json"
    stdout_path = RUN_STATE_DIR / f"{run_id}.stdout.jsonl"
    if not receipt_path.is_file() or receipt_path.is_symlink():
        raise SystemExit("Run receipt was not found.")
    receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
    final_response = ""
    session_id = ""
    if stdout_path.is_file() and not stdout_path.is_symlink():
        with stdout_path.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                candidate_session = event.get("session_id")
                if isinstance(candidate_session, str) and candidate_session:
                    session_id = candidate_session
                if event.get("type") == "result":
                    response = event.get("result")
                    if isinstance(response, str) and response.strip():
                        final_response = response.strip()
    print(
        json.dumps(
            {
                **receipt,
                "session_id": session_id,
                "final_response": final_response,
            },
            ensure_ascii=False,
        )
    )


def run_claude(
    repository: Path,
    command: list[str],
    run_id_value: str,
) -> None:
    run_id = str(uuid.UUID(run_id_value))
    RUN_STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(RUN_STATE_DIR, 0o700)
    cutoff = datetime.now(UTC) - timedelta(days=30)
    for path in RUN_STATE_DIR.glob("*"):
        try:
            if datetime.fromtimestamp(path.stat().st_mtime, UTC) < cutoff:
                path.unlink()
        except OSError:
            pass

    stdout_path = RUN_STATE_DIR / f"{run_id}.stdout.jsonl"
    stderr_path = RUN_STATE_DIR / f"{run_id}.stderr.log"
    receipt_path = RUN_STATE_DIR / f"{run_id}.receipt.json"
    temporary_receipt = receipt_path.with_suffix(".tmp")
    for path in (stdout_path, stderr_path, receipt_path, temporary_receipt):
        path.unlink(missing_ok=True)
    started_at = datetime.now(UTC).isoformat()

    stdout_spool = stdout_path.open("xb", buffering=0)
    stderr_spool = stderr_path.open("xb", buffering=0)
    os.chmod(stdout_path, 0o600)
    os.chmod(stderr_path, 0o600)

    def copy_stream(source, destination, output) -> None:
        spool_available = True
        output_available = True
        try:
            while chunk := source.read(65536):
                if spool_available:
                    try:
                        destination.write(chunk)
                    except OSError:
                        spool_available = False
                if output_available:
                    try:
                        output.write(chunk)
                        output.flush()
                    except (BrokenPipeError, OSError):
                        output_available = False
        finally:
            destination.close()

    process = subprocess.Popen(
        command,
        cwd=repository,
        env=os.environ.copy(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        bufsize=0,
    )
    assert process.stdout is not None
    assert process.stderr is not None

    stdout_thread = threading.Thread(
        target=copy_stream,
        args=(process.stdout, stdout_spool, sys.stdout.buffer),
        daemon=True,
    )
    stderr_thread = threading.Thread(
        target=copy_stream,
        args=(process.stderr, stderr_spool, sys.stderr.buffer),
        daemon=True,
    )
    stdout_thread.start()
    stderr_thread.start()
    return_code = process.wait()
    stdout_thread.join()
    stderr_thread.join()
    temporary_receipt.write_text(
        json.dumps(
            {
                "run_id": run_id,
                "started_at": started_at,
                "finished_at": datetime.now(UTC).isoformat(),
                "exit_code": return_code,
            }
        ),
        encoding="utf-8",
    )
    os.chmod(temporary_receipt, 0o600)
    os.replace(temporary_receipt, receipt_path)
    raise SystemExit(return_code)


def main() -> None:
    try:
        request = json.loads(sys.stdin.read())
        action = request.get("action", "run")
        if action == "recover_session":
            recover_session(str(request["session_id"]))
            return
        if action == "inspect_repository":
            inspect_repository(str(request["repository"]))
            return
        if action == "recover_run_receipt":
            recover_run_receipt(str(request["run_id"]))
            return
        if action != "run":
            raise SystemExit("Unsupported agent action.")
        repository = Path(request["repository"]).resolve()
        command = request["command"]
        run_id = str(uuid.UUID(str(request["run_id"])))
    except (
        json.JSONDecodeError,
        KeyError,
        TypeError,
        ValueError,
        OSError,
    ) as error:
        raise SystemExit(f"Invalid agent request: {error}") from error

    if not repository.is_relative_to(REPO_ROOT) or not repository.is_dir():
        raise SystemExit("Repository is outside the approved root or missing.")
    if (
        not isinstance(command, list)
        or not command
        or command[0] != CLAUDE_BINARY
        or any(not isinstance(argument, str) for argument in command)
    ):
        raise SystemExit("Only the configured Claude command is allowed.")

    os.chdir(repository)
    load_google_environment()
    os.environ["CLAUDE_CODE_DISABLE_BACKGROUND_TASKS"] = "1"
    run_claude(repository, command, run_id)


if __name__ == "__main__":
    main()
