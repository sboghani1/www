[Unit]
Description=Private @wnbaguesser_bot WNBA lean intake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=receptionist-agent
Group=receptionist-agent
WorkingDirectory=/opt/wnba-poller
Environment=HOME=/home/receptionist-agent
Environment=PATH=/opt/wnba-poller/current/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/home/receptionist-agent/.config/wnba-guesser/env
ExecStart=/opt/wnba-poller/current/bin/wnba-guesser-bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/receptionist-agent/.config/wnba-guesser
NoNewPrivileges=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryAccounting=true
MemoryHigh=128M
MemoryMax=192M
TasksMax=64
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
