[Unit]
Description=Private Telegram clipboard bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=receptionist-agent
Group=receptionist2-state
WorkingDirectory=/opt/telegram-clipboard
Environment=HOME=/home/receptionist-agent
Environment=PATH=/opt/telegram-clipboard/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/home/receptionist-agent/.config/telegram-clipboard/env
StateDirectory=telegram-clipboard
StateDirectoryMode=0770
ExecStart=/opt/telegram-clipboard/current/.venv/bin/telegram-clipboard-bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/receptionist-agent/.config/telegram-clipboard
ReadWritePaths=/var/lib/telegram-clipboard
NoNewPrivileges=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryAccounting=true
MemoryHigh=256M
MemoryMax=384M
TasksMax=96
UMask=0007
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
